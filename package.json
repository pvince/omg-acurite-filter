{
  "name": "omg-acurite-filter",
  "version": "1.0.0",
  "author": "Paul Vincent",
  "description": "Listens for data from OpenMQTTGateway and relays it back to MQTT after filtering out suspect data.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "start": "node -r ts-node/register src/app.ts",
    "test": "cross-env NODE_ENV=test mocha src/**/*.spec.ts",
    "test:no-exit": "cross-env NODE_ENV=test mocha src/**/*.spec.ts",
    "test:coverage": "cross-env NODE_ENV=test npx --yes c8 --all --src src --exclude \"src/**/*.spec.ts\" -r text -r text-summary mocha \"src/**/*.spec.ts\"",
    "test:coverage:json": "cross-env NODE_ENV=test npx --yes c8 --all --src src --exclude \"src/**/*.spec.ts\" --reporter=json-summary --reporter=json mocha \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "app-root-path": "^3.1.0",
    "compression": "^1.8.1",
    "dateformat": "^5.0.3",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "format-duration": "^3.0.2",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.18.1",
    "mqtt": "^5.15.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "toad-scheduler": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/compression": "^1.8.1",
    "@types/dateformat": "^5.0.3",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "chai": "^6.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.6.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "ts-node-register": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
