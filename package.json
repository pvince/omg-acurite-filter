{
  "name": "omg-acurite-filter",
  "version": "1.0.0",
  "author": "Paul Vincent",
  "description": "Listens for data from OpenMQTTGateway and relays it back to MQTT after filtering out suspect data.",
  "engines": {
    "node": ">=18.2.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node -r ts-node/register src/app.ts",
    "test": "mocha src/**/*.spec.ts",
    "test:no-exit": "mocha src/**/*.spec.ts",
    "test:coverage": "npx --yes c8 --all --src src --exclude \"src/**/*.spec.ts\" -r text -r text-summary mocha \"src/**/*.spec.ts\"",
    "test:coverage:json": "npx --yes c8 --all --src src --exclude \"src/**/*.spec.ts\" --reporter=json-summary --reporter=json mocha \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "app-root-path": "^3.1.0",
    "compression": "^1.8.1",
    "dateformat": "^5.0.3",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-async-handler": "^1.2.0",
    "format-duration": "^3.0.2",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.18.1",
    "mqtt": "^5.15.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "toad-scheduler": "^4.0.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/compression": "^1.8.1",
    "@types/dateformat": "^5.0.3",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.25",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^46.10.1",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "ts-node-register": "^1.0.0",
    "typescript": "^5.9.3"
  }
}
